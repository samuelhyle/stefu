{
  "name": "stefu-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:sitemap && npm run build:vite",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "build:vite": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "game-server": "node game/server/index.js",
    "dev:game": "concurrently \"npm run dev\" \"npm run game-server\""
  },
  "dependencies": {
    "@mux/mux-node": "^14.0.0",
    "@mux/mux-player": "^3.11.8",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/supabase-js": "^2.39.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-player": "^2.14.1",
    "react-router-dom": "^7.14.2",
    "socket.io-client": "^4.8.3",
    "swiper": "^11.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "jsdom": "^28.1.0",
    "msw": "^2.15.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
