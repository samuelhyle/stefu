# Supabase — https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Mux — https://dashboard.mux.com/settings/access-tokens
VITE_MUX_TOKEN_ID=your_mux_token_id
VITE_MUX_TOKEN_SECRET=your_mux_token_secret
VITE_MUX_SIGNING_KEY_ID=your_mux_signing_key_id
VITE_MUX_SIGNING_KEY_PRIVATE=your_mux_signing_key_private

# Mux Live Stream — set this to your live stream's playback ID when you're streaming
VITE_MUX_LIVE_PLAYBACK_ID=

# Stripe — https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Stripe Price IDs — create products in Stripe dashboard and paste their price IDs
VITE_STRIPE_PRICE_INNER_CIRCLE_MONTHLY=price_...
VITE_STRIPE_PRICE_INNER_CIRCLE_YEARLY=price_...
VITE_STRIPE_PRICE_MERCH_HOODIE=price_...
VITE_STRIPE_PRICE_MERCH_CAP=price_...
VITE_STRIPE_PRICE_MERCH_TSHIRT=price_...
VITE_STRIPE_PRICE_MERCH_POSTER=price_...

# Radio Stream
VITE_RADIO_STREAM_URL=https://your-stream-server.com/radio

# Game server — defaults to window.location.origin in prod, localhost:3000 in dev
VITE_GAME_SERVER_URL=

# Admin email — restricts /#admin to this email. Leave empty to allow any signed-in user.
VITE_ADMIN_EMAIL=
